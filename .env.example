# URL del backend de Twenty (sin / al final)
TWENTY_API_URL=https://tu-twenty.example.com

# Clave de API de Twenty (Settings → APIs & Webhooks)
TWENTY_API_KEY=

# Base de datos de usuarios (con `docker compose up -d` queda así)
DATABASE_URL=postgres://tennistrack:tennistrack@localhost:5432/tennistrack

# Secreto para firmar la sesión, largo y aleatorio (openssl rand -base64 48)
JWT_SECRET=

# Correo para los códigos. Sin SMTP_HOST, en desarrollo el código
# se imprime en la consola y en producción la API responde 503.
SMTP_HOST=
# 465 = TLS, 587 = STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="TennisTrack <no-reply@dominio.com>"
