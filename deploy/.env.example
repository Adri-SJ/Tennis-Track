# Copia este archivo a deploy/.env y llénalo. Nunca subas deploy/.env a git.
# Genera cada secreto con: openssl rand -base64 32

# Subdominios (registros A hacia la IP del servidor)
DOMINIO_PANEL=panel.tudominio.com
DOMINIO_TWENTY=twenty.tudominio.com

# PostgreSQL: contraseñas nuevas, sin caracteres especiales (solo letras y números)
PG_PASSWORD=
TENNISTRACK_DB_PASSWORD=

# Twenty: copia ENCRYPTION_KEY y APP_SECRET del .env de la instalación actual
# para que los datos cifrados y la API key sigan funcionando tras restaurar.
TWENTY_TAG=v2.37.0
TWENTY_ENCRYPTION_KEY=
TWENTY_FALLBACK_ENCRYPTION_KEY=
TWENTY_APP_SECRET=

# Panel
TWENTY_API_KEY=
JWT_SECRET=

# Correo (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
CORREO_REMITENTE="TennisTrack <no-reply@ozkytech.com>"
